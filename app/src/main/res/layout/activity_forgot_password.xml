<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_left" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- STEP 1: Find your account (Mobile or Email) -->
            <LinearLayout
                android:id="@+id/layoutFindAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Find your account"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Enter your mobile number."
                    android:textColor="#4B5563"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_rounded_input_outline"
                    android:hint="Mobile number"
                    android:inputType="phone"
                    android:paddingHorizontal="16dp"
                    android:textColor="#000000"
                    android:textColorHint="#9CA3AF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnContinue"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_blue_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Continue"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnToggleSearchMode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_outline_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Search by email"
                    android:textColor="#1C1C1E"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- STEP 2: Enter Verification Code -->
            <LinearLayout
                android:id="@+id/layoutVerificationCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Enter confirmation code"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCodeSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="We sent a 6-digit confirmation code to your device."
                    android:textColor="#4B5563"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etVerificationCode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_rounded_input_outline"
                    android:gravity="center"
                    android:hint="••••••"
                    android:inputType="number"
                    android:letterSpacing="0.3"
                    android:maxLength="6"
                    android:paddingHorizontal="16dp"
                    android:textColor="#000000"
                    android:textColorHint="#9CA3AF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnConfirmCode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_blue_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Confirm Code"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnResendCode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_outline_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Resend code"
                    android:textColor="#1C1C1E"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- STEP 3: Reset Password (New Password) -->
            <LinearLayout
                android:id="@+id/layoutResetPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Create new password"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Your new password must be at least 6 characters long."
                    android:textColor="#4B5563"
                    android:textSize="15sp" />

                <!-- New Password -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp">

                    <EditText
                        android:id="@+id/etNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_rounded_input_outline"
                        android:hint="New password"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="46dp"
                        android:textColor="#000000"
                        android:textColorHint="#9CA3AF"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/btnToggleNewPassword"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Toggle Password"
                        android:focusable="true"
                        android:padding="12dp"
                        android:src="@drawable/ic_visibility_off" />
                </RelativeLayout>

                <!-- Confirm Password -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp">

                    <EditText
                        android:id="@+id/etConfirmNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_rounded_input_outline"
                        android:hint="Confirm new password"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="46dp"
                        android:textColor="#000000"
                        android:textColorHint="#9CA3AF"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/btnToggleConfirmNewPassword"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Toggle Confirm Password"
                        android:focusable="true"
                        android:padding="12dp"
                        android:src="@drawable/ic_visibility_off" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/btnSaveNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_blue_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Save Password &amp; Log In"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Loading Progress -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:indeterminateTint="#0064E0"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
