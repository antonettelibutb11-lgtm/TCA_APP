<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0716">

    <!-- ── GRADIENT ACCENT HEADER ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_alignParentTop="true"
        android:background="#160829" />

    <!-- ── TOP APP BAR ── -->
    <LinearLayout
        android:id="@+id/qrTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="16dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBackQr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="QR Voting Scanner"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Direct Database Sync"
                android:textColor="#A78BFA"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Status Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1B5E20"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="● LIVE"
            android:textColor="#A5D6A7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

    </LinearLayout>

    <!-- ── SCROLLABLE BODY ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/qrTopBar"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="36dp">

            <!-- ── HEADER TEXT ── -->
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="Scan QR Code to Vote"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Align the Voting QR code within the frame to cast your vote"
                android:textColor="#A78BFA"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2" />

            <!-- ── CAMERA VIEWFINDER FRAME (Rounded Card + Vector Corners) ── -->
            <FrameLayout
                android:layout_width="270dp"
                android:layout_height="270dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp">

                <!-- Rounded Camera Preview View -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#0D0818">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Live Camera Surface -->
                        <androidx.camera.view.PreviewView
                            android:id="@+id/previewView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Animated Laser Scanner Line with gradient fade -->
                        <View
                            android:id="@+id/scanLaserLine"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:background="@drawable/bg_laser_gradient" />

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Clean Vector Corner Brackets Overlay -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_qr_viewfinder_corners"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no" />

            </FrameLayout>

            <!-- ── FLASHLIGHT / TORCH BUTTON ── -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnTorch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_torch"
                    android:clickable="true"
                    android:contentDescription="Flashlight Toggle"
                    android:focusable="true"
                    android:padding="11dp"
                    android:src="@drawable/ic_flashlight"
                    app:tint="#F59E0B" />
            </LinearLayout>

            <!-- ── INSTRUCTIONS PILL CHIPS ROW ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_scanner_chip"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="⚡ Fast Scan"
                    android:textColor="#DDD6FE"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View android:layout_width="8dp" android:layout_height="1dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_scanner_chip"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="🔒 Auto-Verified"
                    android:textColor="#DDD6FE"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View android:layout_width="8dp" android:layout_height="1dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_scanner_chip"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="☁️ Direct DB"
                    android:textColor="#DDD6FE"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ── PROGRESS BAR ── -->
            <ProgressBar
                android:id="@+id/pbSaving"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:indeterminateTint="#F59E0B"
                android:visibility="gone" />

            <!-- ── ATTENDANCE VERIFIED CARD (hidden until scan) ── -->
            <LinearLayout
                android:id="@+id/cardAttendanceVerified"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_scanner_chip"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1B5E20"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="✓  Vote Recorded"
                        android:textColor="#A5D6A7"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/tvAttendanceStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="✅ Vote Verified &amp; Recorded!"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#36225E" />

                <TextView
                    android:id="@+id/tvEventTitleCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Event: BISU Event"
                    android:textColor="#F3E8FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStudentDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Student: —"
                    android:textColor="#DDD6FE"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAttendanceTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Time: — (Direct Sync)"
                    android:textColor="#A78BFA"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- ── ACTION BUTTONS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <!-- Done & Return -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDone"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_purple_button"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="✓  Done &amp; Return to Calendar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Scan Another -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnScanAnother"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="🔄  Scan Another QR Code"
                    android:textAllCaps="false"
                    android:textColor="#F59E0B"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ── FOOTER DISCLAIMER ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="🔒 Voting &amp; check-in data is instantly synced to the cloud Firestore database."
                android:textColor="#6D5594"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
