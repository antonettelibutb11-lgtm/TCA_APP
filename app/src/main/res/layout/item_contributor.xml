<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@color/card_bg"
    android:elevation="3dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivContributorAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_bisu_logo_hd" />

    <TextView
        android:id="@+id/tvContributorName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-bold"
        android:text="Name"
        android:textAlignment="center"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvContributorRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Role"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tvContributorBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_badge_gold"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="🏆 Top Contributor"
        android:textColor="#23003B"
        android:textSize="9.5sp"
        android:textStyle="bold" />
        
    <TextView
        android:id="@+id/tvPostCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 posts"
        android:textColor="@color/text_secondary"
        android:textSize="9sp" />
</LinearLayout>
