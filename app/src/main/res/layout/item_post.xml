<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_white"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/layoutBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <ImageView
            android:id="@+id/imgPin"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_pin_red" />

        <TextView
            android:id="@+id/tvBadgeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="sans-serif-bold"
            android:text="Pinned Advisory"
            android:textColor="@color/purple_primary_text"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgAuthorAvatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_bisu_logo_hd" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAuthorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="BISU Balilihan Admin"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPostMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 hrs ago • Literature &amp; Arts"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnMoreOptions"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top"
            android:padding="2dp"
            android:src="@drawable/ic_more_vert" 
            android:contentDescription="More options"
            android:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPostContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="1.5dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="Announcing the Annual BISU Literary &amp; Creative Writing Contest! Submit your original poems, essays, and short stories before August 30. Outstanding student works will be featured on The Campus Access Hub!"
        android:textColor="@color/text_primary"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/tvSeeMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:text="See more"
        android:textColor="@color/purple_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:paddingEnd="6dp"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/layoutMediaContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <include
            android:id="@+id/post_collage"
            layout="@layout/layout_post_collage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/layoutSingleVideo"
        android:layout_width="match_parent"
        android:layout_height="175dp"
        android:layout_marginTop="6dp"
        android:background="#000000"
        android:visibility="gone">

        <VideoView
            android:id="@+id/vvSingleVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/divider_color" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 1. Like (Outline Heart / Filled Heart) -->
        <LinearLayout
            android:id="@+id/btnLike"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivLikeIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_heart_outline" />

            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <!-- Hidden legacy view for ID compatibility -->
            <TextView
                android:id="@+id/tvLikeIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 2. Comment (Outline Speech Bubble) -->
        <LinearLayout
            android:id="@+id/btnComment"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCommentIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chat_outline" />

            <TextView
                android:id="@+id/tvCommentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Repost (Outline Repost Arrows) -->
        <LinearLayout
            android:id="@+id/btnRepost"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivRepostIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_repost_outline" />
        </LinearLayout>

        <!-- 4. Send / Share (Outline Paper Airplane) -->
        <LinearLayout
            android:id="@+id/btnSendPost"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivSendIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_send_share_outline" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
