<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_white"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvReason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Reason: Duplicate Picture / Video Detection"
            android:textColor="@color/red_danger"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAiConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Score: 98%"
            android:textColor="@color/purple_primary_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvContentPreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Post content sample flagged by AI automated detection filter..."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnWarn"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_unselected"
            android:text="Warn"
            android:textAllCaps="false"
            android:textColor="@color/orange_warning"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRemove"
            android:layout_width="85dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_gold_button"
            android:text="Remove"
            android:textAllCaps="false"
            android:textColor="@color/red_danger"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnApprove"
            android:layout_width="85dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_purple_button"
            android:text="Approve"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
