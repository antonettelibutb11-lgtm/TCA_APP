<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/purple_primary" />
            <size android:width="90dp" android:height="90dp" />
        </shape>
    </item>

    <item android:top="0dp" android:left="0dp" android:right="45dp" android:bottom="45dp">
        <shape android:shape="oval">
            <solid android:color="@color/gold_accent" />
        </shape>
    </item>

    <item android:top="45dp" android:left="0dp" android:right="45dp" android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/purple_light" />
        </shape>
    </item>

    <item android:top="22dp" android:left="22dp" android:right="22dp" android:bottom="22dp">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>
</layer-list>
